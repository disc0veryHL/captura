{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Captura",
  "mainBinaryName": "Captura",
  "version": "2.0.0",
  "identifier": "app.captura.desktop",
  "build": {
    "frontendDist": "../public",
    "beforeBuildCommand": "npm run vendor && npm run icon"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Captura",
    "copyright": "Captura",
    "shortDescription": "Photo library, viewer and screenshot tool",
    "longDescription": "Captura — photo library, Picasa-style viewer and screenshot tool for Windows",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "../build/tauri-hooks.nsh",
        "languages": ["English", "Spanish", "French", "Russian", "SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
